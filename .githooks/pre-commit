#!/bin/sh
set -eu

blocked_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -Ev '\.example$' || true)
if [ -n "$blocked_files" ]; then
  printf '%s\n' '提交已阻止：暂存区包含本地环境配置文件：' >&2
  printf '%s\n' "$blocked_files" >&2
  exit 1
fi

staged_diff=$(git diff --cached --unified=0 --no-color --diff-filter=ACMR -- . ':(exclude)*.example')
if printf '%s\n' "$staged_diff" | grep -E '^\+[^+].*(LLM_API_KEY|OPENAI_API_KEY|DASHSCOPE_API_KEY|DEEPSEEK_API_KEY)[[:space:]]*[:=][[:space:]]*[^$[:space:]][^[:space:]]+' >/dev/null; then
  printf '%s\n' '提交已阻止：检测到疑似硬编码的大模型 API Key。请改用环境变量，并将真实值放入 .env。' >&2
  exit 1
fi

if printf '%s\n' "$staged_diff" | grep -E '^\+[^+].*(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}' >/dev/null; then
  printf '%s\n' '提交已阻止：检测到疑似 sk-* 密钥。' >&2
  exit 1
fi

exit 0
