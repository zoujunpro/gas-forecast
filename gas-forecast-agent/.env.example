GAS_AGENT_HOST=0.0.0.0
GAS_AGENT_PORT=8091
# 本地开发连接 IDEA 启动的 Java 服务；Jenkins 部署环境单独覆盖为 18081。
GAS_MCP_URL=http://127.0.0.1:18083/gas-forecast/mcp
# 与 Java 服务现有认证方式保持一致，例如：Bearer <token>
GAS_MCP_AUTHORIZATION=
GAS_MCP_TIMEOUT_SECONDS=30
# hybrid: 明确表达走规则，复杂表达走千问；也可显式设为llm或rules
GAS_SKILL_ROUTING_MODE=hybrid
# 复用项目已有千问配置（DashScope OpenAI兼容接口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
GAS_LLM_TIMEOUT_SECONDS=120
# 单次请求的Agent安全预算，不是固定业务步骤数
GAS_AGENT_MAX_STEPS=8
GAS_AGENT_MAX_DURATION_SECONDS=45
GAS_AGENT_MAX_SAME_TOOL_CALLS=2
GAS_AGENT_MAX_WRITE_CALLS=1
GAS_AGENT_MAX_READ_RETRIES=1
