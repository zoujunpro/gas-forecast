GAS_AGENT_HOST=0.0.0.0
GAS_AGENT_PORT=8091
GAS_MCP_URL=http://127.0.0.1:18083/gas-forecast/mcp
# 与 Java 服务现有认证方式保持一致，例如：Bearer <token>
GAS_MCP_AUTHORIZATION=
GAS_MCP_TIMEOUT_SECONDS=30
# hybrid: 明确表达走规则，复杂表达走千问；也可显式设为llm或rules
GAS_INTENT_MODE=hybrid
# 复用项目已有千问配置（DashScope OpenAI兼容接口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
GAS_LLM_TIMEOUT_SECONDS=120

# LangGraph只使用专用账号访问单张检查点表，禁止填写业务库root账号。
GAS_CHECKPOINT_ENABLED=false
GAS_CHECKPOINT_HOST=127.0.0.1
GAS_CHECKPOINT_PORT=3306
GAS_CHECKPOINT_DATABASE=gas_data
GAS_CHECKPOINT_USERNAME=gas_agent
GAS_CHECKPOINT_PASSWORD=
GAS_CHECKPOINT_TABLE=agent_graph_checkpoint_tb
